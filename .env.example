# Server & AWS Cloud Configuration
PORT=5000

# ElevenLabs Text-to-Speech API (Keep strictly server-side)
# Get your API key from https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: ElevenLabs Voice ID (Defaults to multilingual Indian/Hindi voice)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# AWS Cloud Integration (Leave blank to use local storage / in-memory adapter)
AWS_REGION=ap-south-1
DYNAMODB_TABLE_JOBS=KaamNearby_Jobs
DYNAMODB_TABLE_APPLICATIONS=KaamNearby_Applications
AWS_S3_BUCKET=kaamnearby-assets
